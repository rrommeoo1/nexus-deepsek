# Nexus local (copy to .env and fill in real values to activate providers)

# Runtime mode. Keep development locally; production activates fail-closed gates.
NODE_ENV=development
NEXUS_DEPLOYMENT_MODE=local

# Session signing secret. Leave empty in the committed template. Production
# refuses to start unless this is a random value of at least 32 characters.
NEXUS_SESSION_SECRET=
# Free Jamendo developer client id (read-only /tracks API; keep this server-side).
JAMENDO_CLIENT_ID=

# Google OAuth (create OAuth Client ID at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login (create app at https://developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Explicit supported Graph API version, for example v23.0. Provider remains
# disabled until all three Facebook values are set and app review is complete.
FACEBOOK_GRAPH_VERSION=

# MultiversX auth
# Rețeaua folosită la validarea tokenului NativeAuth (xPortal semnează pe mainnet):
#   mainnet | devnet
NEXUS_MVX_NETWORK=mainnet
# WalletConnect Cloud Project ID (https://cloud.walletconnect.com)
NEXUS_WC_PROJECT_ID=
# Setează true numai după ce ID-ul a fost emis pentru proiectul Nexus în
# WalletConnect Dashboard. O valoare cu format valid nu este suficientă.
NEXUS_WC_PROJECT_ATTESTED=false
# Originile confirmate în WalletConnect Dashboard > Project Settings > Allowlist.
# Potrivirea este exactă, inclusiv schema și portul.
NEXUS_WC_ATTESTED_ORIGINS=
# Origin acceptate la validarea NativeAuth (separate prin virgulă). Adaugă aici
# originea reală a aplicației când rulezi prin tunel/proxy (VS Code, cloudflare etc).
NEXUS_ACCEPTED_ORIGINS=http://localhost:3000

# Optional local HTTPS for in-browser Camera/Live testing on a trusted phone.
HTTPS_PORT=3443
NEXUS_TLS_PFX_PATH=.certs/nexus-local-dev.pfx
NEXUS_TLS_PASSPHRASE=nexus-local-dev
# Base extern folosit la OAuth (Google redirect). Pentru tunel setează URL-ul public.
NEXUS_ORIGIN=http://localhost:3000

# Networking
PORT=3000
HOST=0.0.0.0

# Development-only E2EE device lab. It is always unavailable in production.
NEXUS_DEVICE_LAB=false

# Persistent storage. Production requires an absolute, backed-up path.
# Windows example: C:\Nexus\data
# Linux example: /var/lib/nexus
NEXUS_DATA_DIR=
# Local/single-node default. A distributed object-storage adapter remains an
# explicit audited provider + cost gate; unsupported values fail closed.
NEXUS_MEDIA_STORAGE_PROVIDER=local-content-addressed

# Production rate limiting is delegated to a configured trusted edge. Set both
# values only when the app is firewalled from direct public access and the edge
# overwrites (not appends) X-Forwarded-For / X-Forwarded-Proto.
NEXUS_RATE_LIMIT_MODE=
NEXUS_TRUST_PROXY=0

# GDPR purge is dry-run by default. Production execution requires both controls
# for one explicitly approved run. Never commit a real approval identifier.
NEXUS_ACCOUNT_PURGE_EXECUTE=0
NEXUS_ACCOUNT_PURGE_APPROVAL_ID=

# Emergency control CLI is read-only by default. Pausing requires actor + scoped
# approval; resuming additionally requires a distinct checker identity.
NEXUS_INCIDENT_CONTROL_EXECUTE=0
NEXUS_INCIDENT_APPROVAL_ID=
NEXUS_INCIDENT_ACTOR=
NEXUS_INCIDENT_CHECKER=

# Action Ledger repair is denied by default. The read-only command needs no
# flag; set this to 1 only for one reviewed local derived-state repair run.
NEXUS_ACTION_RECONCILE_REPAIR=0

# Breaking news is served only by an allow-listed aggregator, and it stays disabled until one is named
# here. The registry of approved aggregators lives in lib/news-provider.js; an unknown name is refused
# instead of guessed, and a provider that needs a key stays disabled until the key is present.
# NEXUS_NEWS_PROVIDER=gdelt
# NEXUS_NEWS_PROVIDER_TOKEN=
# Extra hosts may be appended to a provider's own allow-list, as plain hostnames only.
# NEXUS_NEWS_PROVIDER_HOSTS=
# NEXUS_NEWS_QUERY=world
# NEXUS_NEWS_MAX_ITEMS=30
# NEXUS_NEWS_CACHE_TTL_SECONDS=900
# NEXUS_NEWS_TIMEOUT_MS=6000
# A loopback fixture proves the whole path on one machine, with no external network: it is refused in
# production, speaks http only to 127.0.0.1, and needs its address given explicitly.
# NEXUS_NEWS_PROVIDER=local-fixture
# NEXUS_NEWS_FIXTURE_URL=http://127.0.0.1:5051/fixture

