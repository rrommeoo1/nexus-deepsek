{
  "name": "nexus-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^5.2.3",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-dev.ps1",
    "lint": "expo lint",
    "dev:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action dev",
    "dev:metro": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action metro",
    "dev:mirror": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action mirror",
    "dev:reverse": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action reverse",
    "dev:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action web",
    "dev:reload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action reload",
    "dev:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action open",
    "dev:wake": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action wake",
    "dev:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action restore",
    "dev:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action logs",
    "dev:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action ui",
    "dev:login": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action login",
    "dev:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action doctor",
    "dev:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action tools",
    "dev:device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action device",
    "dev:setup-scrcpy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action setup-scrcpy",
    "install:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nexus-dev.ps1 -Action install"
  },
  "private": true
}
