{
  "expo": {
    "name": "Jungle Book Dev",
    "slug": "nexus-mobile",
    "version": "0.1.0",
    "scheme": "nexusdev",
    "orientation": "portrait",
    "icon": "./assets/brand/jb-icon-1024.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.nexus.mobile.dev",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#02150D",
        "foregroundImage": "./assets/brand/jb-icon-foreground-1024.png",
        "monochromeImage": "./assets/brand/jb-icon-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/jb-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/jb-mark-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/brand/jb-mark-1024.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ]
  }
}
