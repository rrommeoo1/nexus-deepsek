# Jungle Book local backend — configuration template.
#
# `init-local-backend.mjs` copies this to C:\Nexus\env\jungle.env and fills NEXUS_SESSION_SECRET with a
# fresh random value. That real file is the only one the service reads; it is never committed, never
# printed, and it is the single place a port, a path or a secret is configured.
#
# Development mode on purpose: the phone reaches this server over the LAN as plain HTTP on a trusted
# home network, which is the arrangement the app's own README documents. `NODE_ENV=production` refuses
# every non-TLS request (lib/api.js), which would make a LAN address unreachable without a certificate
# the phone trusts. The remote path (a tunnel) terminates TLS at the edge instead of weakening anything.

NODE_ENV=development
NEXUS_DEPLOYMENT_MODE=local

# Where the database, the media store and the quarantine live. Absolute, outside the repository, so a
# `git clean`, a worktree switch or a reinstall cannot delete production data.
NEXUS_DATA_DIR=C:\Nexus\data

# The port the app, the phone and the tunnel all use. 5000 is the port the previous local service used.
PORT=5000
HOST=0.0.0.0

# Session signing secret (>= 32 chars). Generated once, on this machine, and never shared: changing it
# signs every phone out, which is the intended effect of a rotation.
NEXUS_SESSION_SECRET=

# Local HTTPS for the in-browser camera lab only; the phone does not use it.
HTTPS_PORT=3443

# The origins the app accepts an authenticated request from. The LAN address is added by the installer
# so a browser on the phone can also use the backend.
NEXUS_ACCEPTED_ORIGINS=http://localhost:5000

# Providers stay empty unless the owner supplies their own credentials. An empty value disables the
# provider instead of pretending it works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JAMENDO_CLIENT_ID=
NEXUS_WC_PROJECT_ID=
