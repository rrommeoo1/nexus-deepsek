# Dependencies and generated build output
node_modules/
coverage/
dist/
.next/
out/
target/
__pycache__/
*.py[cod]

# Local agent/runtime state
.ephemeral/
.codex/
planning/evidence/screenshots/chrome-profile-*/

# Secrets and machine-local configuration
**/.env
**/.env.*
!**/.env.example
**/.certs/
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

# Local-only test session cookies / passwords written by
# apps/nexus-web/scripts/seed-preview-test-data.mjs
docs/.test-sessions.local

# Runtime databases, uploads and logs
apps/nexus-web/data/
tools/cloudflared.exe
tools/scrcpy/
**/*.log
**/*.err
**/*.out
*.sqlite
*.sqlite3
*.db

# Local diagnostics: adb UI dumps, lint and gate output. They are evidence for one session,
# never product files, and some of them carry account names — so they stay out of history.
temp-ui*.xml
apps/nexus-mobile/lint-*.txt
apps/nexus-web/_*.txt

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated, validated JPEGs for vision reads (see tools/images/to-vision.ps1).
# The originals stay in docs/screens, docs/web-ref, docs/parity-report and docs/design-refs;
# this folder is a cache and must never be committed.
docs/vision/

